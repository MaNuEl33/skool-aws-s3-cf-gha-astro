---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Popshop: objetos bonitos, hallazgos inesperados y pequeños caprichos para todos los días."
		/>
		<meta name="theme-color" content="#fffaf2" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://images.unsplash.com" />
		<title>Popshop — Cosas buenas, días mejores</title>
		<style>
			@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

			:root {
				font-family: 'DM Sans', sans-serif;
				color: #25231f;
				background: #fffaf2;
				font-synthesis: none;
				text-rendering: optimizeLegibility;
				--ink: #25231f;
				--muted: #716d66;
				--cream: #fffaf2;
				--paper: #fffdf9;
				--orange: #fa6539;
				--purple: #6f50e8;
				--line: #e9e3da;
				--heading: 'Space Grotesk', sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				min-width: 320px;
			}

			button,
			input {
				font: inherit;
			}

			button,
			a {
				-webkit-tap-highlight-color: transparent;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			button {
				color: inherit;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				clip-path: inset(50%);
			}

			.announcement {
				display: flex;
				min-height: 36px;
				align-items: center;
				justify-content: center;
				gap: 8px;
				padding: 7px 16px;
				background: var(--purple);
				color: white;
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 0.045em;
				text-align: center;
			}

			.announcement span {
				color: #ffce68;
			}

			.site-header {
				position: sticky;
				z-index: 10;
				top: 0;
				background: rgb(255 250 242 / 94%);
				backdrop-filter: blur(14px);
				border-bottom: 1px solid rgb(233 227 218 / 75%);
			}

			.search-panel {
				position: absolute;
				top: 100%;
				right: max(calc((100vw - 1240px) / 2), 32px);
				width: min(420px, calc(100vw - 32px));
				padding: 12px;
				border: 1px solid var(--line);
				border-radius: 0 0 10px 10px;
				background: var(--paper);
				box-shadow: 0 14px 28px rgb(37 35 31 / 10%);
			}

			.search-panel[hidden] {
				display: none;
			}

			.search-form {
				display: flex;
				gap: 8px;
			}

			.search-form input {
				width: 100%;
				min-width: 0;
				padding: 0 12px;
				border: 1px solid var(--line);
				border-radius: 6px;
				outline-color: var(--purple);
				background: white;
				font-size: 12px;
			}

			.search-form .button {
				min-height: 42px;
				padding: 0 14px;
				font-size: 11px;
			}

			.header-inner {
				display: flex;
				width: min(1240px, calc(100% - 64px));
				height: 78px;
				align-items: center;
				justify-content: space-between;
				margin: 0 auto;
				gap: 28px;
			}

			.brand {
				display: inline-flex;
				align-items: center;
				font-family: var(--heading);
				font-size: 28px;
				font-weight: 700;
				letter-spacing: -0.095em;
			}

			.brand-mark {
				color: var(--orange);
			}

			.brand-dot {
				width: 7px;
				height: 7px;
				align-self: flex-start;
				margin: 7px 0 0 3px;
				border-radius: 50%;
				background: var(--purple);
			}

			.main-nav {
				display: flex;
				align-items: center;
				gap: 32px;
				font-size: 13px;
				font-weight: 600;
			}

			.main-nav a {
				transition: color 160ms ease;
			}

			.main-nav a:hover,
			.main-nav a:focus-visible {
				color: var(--orange);
			}

			.header-actions {
				display: flex;
				align-items: center;
				gap: 10px;
			}

			.icon-button {
				display: grid;
				width: 42px;
				height: 42px;
				place-items: center;
				padding: 0;
				border: 1px solid transparent;
				border-radius: 50%;
				background: transparent;
				cursor: pointer;
				transition:
					background 160ms ease,
					border-color 160ms ease;
			}

			.icon-button:hover {
				border-color: var(--line);
				background: white;
			}

			.cart-button {
				position: relative;
			}

			.cart-count {
				position: absolute;
				top: 0;
				right: -1px;
				display: grid;
				width: 18px;
				height: 18px;
				place-items: center;
				border: 2px solid var(--cream);
				border-radius: 50%;
				background: var(--orange);
				color: white;
				font-size: 9px;
				font-weight: 700;
			}

			.menu-toggle {
				display: none;
			}

			.hero {
				position: relative;
				display: grid;
				width: min(1240px, calc(100% - 64px));
				min-height: 506px;
				grid-template-columns: 1fr 0.9fr;
				align-items: center;
				overflow: hidden;
				margin: 28px auto 0;
				border-radius: 24px;
				background: #f7e9d8;
			}

			.hero-copy {
				position: relative;
				z-index: 1;
				padding: 64px 24px 64px 8.5%;
			}

			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				margin: 0 0 18px;
				color: var(--purple);
				font-size: 11px;
				font-weight: 700;
				letter-spacing: 0.15em;
				text-transform: uppercase;
			}

			.eyebrow::before {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--orange);
				content: '';
			}

			h1,
			h2,
			h3,
			p {
				margin-top: 0;
			}

			.hero h1 {
				max-width: 530px;
				margin-bottom: 18px;
				font-family: var(--heading);
				font-size: clamp(48px, 6.1vw, 82px);
				font-weight: 600;
				letter-spacing: -0.075em;
				line-height: 0.98;
			}

			.hero h1 span {
				color: var(--orange);
			}

			.hero-description {
				max-width: 360px;
				margin-bottom: 28px;
				color: #5f5a53;
				font-size: 15px;
				line-height: 1.65;
			}

			.button {
				display: inline-flex;
				min-height: 48px;
				align-items: center;
				justify-content: center;
				gap: 10px;
				padding: 0 21px;
				border: 0;
				border-radius: 7px;
				background: var(--ink);
				color: white;
				font-size: 13px;
				font-weight: 700;
				cursor: pointer;
				transition:
					transform 160ms ease,
					background 160ms ease;
			}

			.button:hover {
				transform: translateY(-2px);
				background: var(--purple);
			}

			.hero-note {
				margin: 14px 0 0;
				color: #777067;
				font-size: 11px;
			}

			.hero-art {
				position: relative;
				height: 100%;
				min-height: 506px;
				overflow: hidden;
				background:
					radial-gradient(ellipse at 68% 33%, #f5b676 0 20%, transparent 20.5%),
					linear-gradient(135deg, #edb894, #f8dcae 55%, #f2a27d);
			}

			.hero-photo {
				position: absolute;
				inset: 38px 9% 0 5%;
				overflow: hidden;
				border-radius: 48% 48% 8px 8px;
				background: #eac5aa;
				transform: rotate(2deg);
			}

			.hero-photo img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: 54% center;
				mix-blend-mode: multiply;
			}

			.hero-sun {
				position: absolute;
				top: 34px;
				right: 9%;
				width: 76px;
				height: 76px;
				border-radius: 50%;
				background: #f8cc54;
			}

			.hero-sticker {
				position: absolute;
				right: 5%;
				bottom: 12%;
				display: grid;
				width: 105px;
				height: 105px;
				place-content: center;
				border: 1px solid rgb(255 255 255 / 55%);
				border-radius: 50%;
				background: var(--purple);
				color: white;
				font-family: var(--heading);
				font-size: 15px;
				font-weight: 700;
				line-height: 1.1;
				text-align: center;
				transform: rotate(10deg);
			}

			.hero-sticker span {
				color: #ffce68;
				font-size: 23px;
			}

			.section {
				width: min(1240px, calc(100% - 64px));
				margin: 0 auto;
			}

			.category-section {
				padding-top: 76px;
			}

			.section-heading {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 20px;
				margin-bottom: 25px;
			}

			.section-heading h2 {
				margin-bottom: 0;
				font-family: var(--heading);
				font-size: clamp(28px, 3.2vw, 40px);
				font-weight: 600;
				letter-spacing: -0.06em;
			}

			.section-heading p {
				margin: 8px 0 0;
				color: var(--muted);
				font-size: 13px;
			}

			.category-list {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 14px;
			}

			.category-card {
				position: relative;
				display: flex;
				min-height: 176px;
				align-items: end;
				overflow: hidden;
				padding: 19px;
				border-radius: 12px;
				background: #e6d8cb;
				isolation: isolate;
			}

			.category-card::before {
				position: absolute;
				z-index: -1;
				inset: 0;
				background-image: var(--category-image);
				background-position: center;
				background-size: cover;
				content: '';
				transition: transform 300ms ease;
			}

			.category-card::after {
				position: absolute;
				z-index: -1;
				inset: 0;
				background: linear-gradient(0deg, rgb(26 22 17 / 62%), transparent 72%);
				content: '';
			}

			.category-card:hover::before {
				transform: scale(1.05);
			}

			.category-card span {
				color: white;
				font-family: var(--heading);
				font-size: 19px;
				font-weight: 600;
				letter-spacing: -0.03em;
			}

			.products-section {
				padding-top: 86px;
				padding-bottom: 92px;
			}

			.shop-link {
				display: inline-flex;
				align-items: center;
				gap: 7px;
				color: var(--purple);
				font-size: 12px;
				font-weight: 700;
			}

			.shop-link:hover {
				color: var(--orange);
			}

			.filter-list {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				margin: 25px 0 24px;
			}

			.filter-button {
				min-height: 35px;
				padding: 0 14px;
				border: 1px solid var(--line);
				border-radius: 99px;
				background: transparent;
				color: #68635c;
				font-size: 11px;
				font-weight: 600;
				cursor: pointer;
				transition: all 150ms ease;
			}

			.filter-button:hover,
			.filter-button[aria-pressed='true'] {
				border-color: var(--ink);
				background: var(--ink);
				color: white;
			}

			.product-grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 34px 18px;
			}

			.product-card[hidden] {
				display: none;
			}

			.product-image {
				position: relative;
				overflow: hidden;
				aspect-ratio: 0.93;
				border-radius: 10px;
				background: #eee8df;
			}

			.product-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 350ms ease;
			}

			.product-card:hover .product-image img {
				transform: scale(1.045);
			}

			.product-label {
				position: absolute;
				top: 12px;
				left: 12px;
				padding: 6px 9px;
				border-radius: 4px;
				background: var(--paper);
				font-size: 9px;
				font-weight: 700;
			}

			.favorite-button {
				position: absolute;
				top: 9px;
				right: 9px;
				display: grid;
				width: 34px;
				height: 34px;
				place-items: center;
				border: 0;
				border-radius: 50%;
				background: var(--paper);
				cursor: pointer;
			}

			.favorite-button[aria-pressed='true'] {
				color: var(--orange);
			}

			.product-info {
				padding: 13px 2px 0;
			}

			.product-name {
				margin-bottom: 7px;
				font-family: var(--heading);
				font-size: 14px;
				font-weight: 600;
				letter-spacing: -0.02em;
			}

			.product-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 8px;
			}

			.product-price {
				display: flex;
				align-items: center;
				gap: 7px;
				font-size: 12px;
				font-weight: 700;
			}

			.old-price {
				color: #9c958b;
				font-size: 10px;
				font-weight: 400;
				text-decoration: line-through;
			}

			.add-button {
				display: inline-grid;
				width: 33px;
				height: 33px;
				flex: 0 0 auto;
				place-items: center;
				border: 1px solid var(--line);
				border-radius: 50%;
				background: transparent;
				cursor: pointer;
				transition: all 150ms ease;
			}

			.add-button:hover,
			.add-button[aria-pressed='true'] {
				border-color: var(--orange);
				background: var(--orange);
				color: white;
			}

			.promise-row {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 18px;
				padding: 25px 0;
				border-top: 1px solid var(--line);
				border-bottom: 1px solid var(--line);
			}

			.promise {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 12px;
				font-size: 11px;
				font-weight: 700;
			}

			.promise-icon {
				display: grid;
				width: 39px;
				height: 39px;
				flex: 0 0 auto;
				place-items: center;
				border-radius: 50%;
				background: #f3e8fc;
				color: var(--purple);
			}

			.promise:nth-child(2) .promise-icon {
				background: #ffebdf;
				color: var(--orange);
			}

			.promise small {
				display: block;
				margin-top: 4px;
				color: var(--muted);
				font-size: 9px;
				font-weight: 400;
			}

			.newsletter {
				display: grid;
				grid-template-columns: 1fr 1fr;
				align-items: center;
				gap: 40px;
				margin-top: 78px;
				padding: 42px 6%;
				border-radius: 16px;
				background: #f2eafb;
			}

			.newsletter h2 {
				margin-bottom: 8px;
				font-family: var(--heading);
				font-size: clamp(25px, 3vw, 36px);
				font-weight: 600;
				letter-spacing: -0.06em;
			}

			.newsletter p {
				margin-bottom: 0;
				color: var(--muted);
				font-size: 12px;
				line-height: 1.6;
			}

			.newsletter-form {
				display: flex;
				padding: 5px;
				border: 1px solid #e0d5ed;
				border-radius: 8px;
				background: white;
			}

			.newsletter-form input {
				width: 100%;
				min-width: 0;
				padding: 0 12px;
				border: 0;
				outline: 0;
				background: transparent;
				font-size: 12px;
			}

			.newsletter-form .button {
				min-height: 42px;
				flex: 0 0 auto;
				padding: 0 15px;
				font-size: 11px;
			}

			.site-footer {
				margin-top: 78px;
				padding: 38px 0 24px;
				border-top: 1px solid var(--line);
			}

			.footer-main {
				display: flex;
				align-items: start;
				justify-content: space-between;
				gap: 32px;
				padding-bottom: 34px;
			}

			.footer-brand {
				max-width: 240px;
			}

			.footer-brand p {
				margin: 12px 0 0;
				color: var(--muted);
				font-size: 11px;
				line-height: 1.6;
			}

			.footer-links {
				display: flex;
				gap: clamp(24px, 5vw, 70px);
			}

			.footer-links h3 {
				margin-bottom: 12px;
				font-size: 10px;
				font-weight: 700;
				text-transform: uppercase;
			}

			.footer-links a {
				display: block;
				margin-top: 8px;
				color: var(--muted);
				font-size: 10px;
			}

			.footer-links a:hover {
				color: var(--purple);
			}

			.footer-bottom {
				display: flex;
				justify-content: space-between;
				gap: 16px;
				padding-top: 18px;
				border-top: 1px solid var(--line);
				color: var(--muted);
				font-size: 9px;
			}

			.toast {
				position: fixed;
				z-index: 20;
				right: 24px;
				bottom: 24px;
				max-width: calc(100vw - 32px);
				padding: 13px 18px;
				border-radius: 8px;
				background: var(--ink);
				box-shadow: 0 8px 28px rgb(37 35 31 / 18%);
				color: white;
				font-size: 12px;
				opacity: 0;
				pointer-events: none;
				transform: translateY(8px);
				transition:
					opacity 180ms ease,
					transform 180ms ease;
			}

			.toast.is-visible {
				opacity: 1;
				transform: translateY(0);
			}

			@media (min-width: 1440px) {
				.hero h1 {
					font-size: 84px;
				}
			}

			@media (max-width: 900px) {
				.header-inner,
				.section,
				.hero {
					width: min(100% - 40px, 720px);
