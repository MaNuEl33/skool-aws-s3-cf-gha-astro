				}

				.eyebrow {
					margin-bottom: 14px;
					font-size: 9px;
				}

				.hero h1 {
					max-width: 420px;
					font-size: clamp(52px, 14vw, 72px);
				}

				.hero-description {
					max-width: 310px;
					font-size: 13px;
				}

				.hero-art {
					min-height: 270px;
				}

				.hero-photo {
					inset: 24px 13% -7px 11%;
				}

				.hero-sun {
