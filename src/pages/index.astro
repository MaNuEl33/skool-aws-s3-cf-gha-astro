									type="button"
									aria-label={`Añadir ${product.name} a favoritos`}
									aria-pressed="false"
									data-favorite
								>
									<svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path d="M20.2 8.8c0 4.1-8.2 10-8.2 10s-8.2-5.9-8.2-10a4.2 4.2 0 0 1 7.6-2.5.8.8 0 0 0 1.2 0 4.2 4.2 0 0 1 7.6 2.5Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.6" />
