				}

				.header-actions {
					gap: 0;
					margin-left: auto;
				}

				.search-panel {
					right: 16px;
				}

				.icon-button {
					width: 38px;
					height: 38px;
				}

				.menu-toggle {
					display: grid;
				}

				.hero {
					min-height: auto;
